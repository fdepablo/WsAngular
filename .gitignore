**/dist/
**/tmp/
**/out-tsc/
**/bazel-out/
*.tsbuildinfo

# Node
**/node_modules/
npm-debug.log
npm-debug.log.*
yarn-error.log
pnpm-debug.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
